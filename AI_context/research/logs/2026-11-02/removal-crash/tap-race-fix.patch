@@ -81,7 +81,10 @@ static void tap_receive(struct tap_base *TAPBase, struct tap_unit *unit)
      * all multicast) and for IPv4 multicast / IGMP.
      */
 
-    /* now we loop through our openers, seeing if anyone wants the packet */
+    /* now we loop through our openers, seeing if anyone wants the packet -
+     * holding read_lock: abort_io() or a close must not take a read while it
+     * is being filled */
+    ObtainSemaphore(&unit->read_lock);
     ForeachNodeSafe(&(unit->openers), opener, opener_next) {
 
         /* loop pending read requests */
@@ -154,6 +157,7 @@ static void tap_receive(struct tap_base *TAPBase, struct tap_unit *unit)
         if (accepted)
             break;
     }
+    ReleaseSemaphore(&unit->read_lock);
 
     if (! accepted) {
         D(bug("[tap] [io:%d] no one claimed the packet, orphaning\n", unit->num));
diff --git a/arch/all-unix/devs/networks/tap/tap.h b/arch/all-unix/devs/networks/tap/tap.h
index 182abb29d2..a64d7b5e0f 100644
--- a/arch/all-unix/devs/networks/tap/tap.h
+++ b/arch/all-unix/devs/networks/tap/tap.h
@@ -118,6 +118,14 @@ struct tap_unit
     ULONG                       flags;
 
     struct MinList              openers;
+    /*
+     * Held while a frame is delivered to the openers' pending reads (the
+     * iotask), while abort_io() takes one back, and while an opener is added
+     * or removed: without it a read could be aborted - replied, and freed by
+     * its owner - while the iotask was still copying into it, and then be
+     * replied a second time.
+     */
+    struct SignalSemaphore      read_lock;
 
     struct MinList              trackers;
     struct Sana2DeviceStats     stats;
